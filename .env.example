# Copy to `.env` (git-ignored) and adjust if needed:  cp .env.example .env
#
# ── Postgres (docker compose) ─────────────────────────────────────────────────
# These feed docker-compose.yml. The defaults are fine for local development.
POSTGRES_USER=sumer
POSTGRES_PASSWORD=sumer
POSTGRES_DB=sumer
POSTGRES_PORT=5432

# ── Application database ──────────────────────────────────────────────────────
# Must match the Postgres settings above.
#   docker compose up -d      # start Postgres
#   pnpm db:setup             # run migrations + seed the base data
#
# No DATABASE_URL (or no .env at all)? The app falls back to an embedded
# PGlite database in `./.pglite`, which needs no Docker at all.
DATABASE_URL=postgresql://sumer:sumer@localhost:5432/sumer

# Where the embedded PGlite database lives when DATABASE_URL is unset.
# PGLITE_DATA_DIR=./.pglite
